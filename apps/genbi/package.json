    "@ant-design/icons": "^6.3.2",
    "@hono/node-server": "^2.0.10",
    "ai": "~7.0.28",
    "antd": "^6.5.1",
    "echarts": "^6.1.0",
    "hono": "^4.12.30",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
